# AppArmor profile that lets Crew (an Electron app) use Chromium's user-namespace sandbox
# on Ubuntu 23.10+, the same way /etc/apparmor.d/chrome does for Google Chrome. It attaches
# only to the root-owned system install in /opt/Crew, never to a user-writable path.
# Installed by: sudo desktop/install-system.sh

abi <abi/4.0>,
include <tunables/global>

profile crew /opt/Crew/crew flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/crew>
}
