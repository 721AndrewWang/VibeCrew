{
  "name": "crew",
  "productName": "Crew",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Crew — 本地运行的 Web 开发 AI 机器人小队（参考 Grokbot）",
  "author": {
    "name": "Crew"
  },
  "main": "desktop/main.cjs",
  "desktopName": "crew.desktop",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch --clear-screen=false server/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/index.ts",
    "app": "npm run build && tsx server/index.ts --open",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "build:server": "node desktop/build-server.mjs",
    "build:desktop": "npm run build && npm run build:server",
    "desktop": "npm run build:desktop && node desktop/dev.mjs",
    "desktop:pack": "npm run build:desktop && node desktop/package.mjs",
    "desktop:install": "node desktop/install.mjs",
    "desktop:uninstall": "node desktop/install.mjs --uninstall",
    "icons": "tsx desktop/gen-icons.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:desktop": "npm run desktop:pack && playwright test -c tests/desktop/playwright.config.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "ci": "npm run check && npm run test:e2e"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk-linux-x64": "file:./vendor/sdk-binary-stub"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@anthropic-ai/sdk": "^0.129.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "chokidar": "^5.0.0",
    "croner": "^10.0.1",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.5",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.crew.desktop",
    "productName": "Crew",
    "executableName": "crew",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "desktop"
    },
    "files": [
      "package.json",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/loading.html",
      "desktop/icons/**",
      "desktop/logos/**",
      "dist-server/**",
      "web/dist/**",
      "server/inject/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-linux-x64{,/**}"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "desktop/icons",
      "synopsis": "Web 开发 AI 机器人小队",
      "artifactName": "Crew-${version}.${ext}"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
